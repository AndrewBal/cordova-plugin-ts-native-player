<?xml version="1.0" encoding="UTF-8"?>
<plugin xmlns="http://apache.org/cordova/ns/plugins/1.0"
        xmlns:ios="http://apple.com/ios/plugins"
        id="cordova-plugin-ts-native-player"
        version="1.2.0">

    <name>TSNativePlayer</name>
    <description>Native playback for remote dashcam .TS files (iOS: MobileVLCKit, Android: libVLC) with direct streaming and a download fallback.</description>
    <license>MIT</license>
    <keywords>cordova,ios,android,dashcam,ts,vlc,mpeg-ts</keywords>

    <js-module src="www/TsNativePlayer.js" name="TsNativePlayer">
        <clobbers target="TSNativePlayer" />
        <clobbers target="window.TSNativePlayer" />
    </js-module>

    <platform name="ios">
        <framework src="UIKit.framework" />
        <framework src="Network.framework" />
        <framework src="SystemConfiguration.framework" />

        <podspec>
            <pods>
                <pod name="MobileVLCKit" />
            </pods>
        </podspec>

        <header-file src="src/ios/TsNativePlayerPlugin.h" />
        <header-file src="src/ios/TsPlaybackManager.h" />
        <header-file src="src/ios/TsPlayerViewController.h" />
        <header-file src="src/ios/TsNetworkHelper.h" />

        <source-file src="src/ios/TsNativePlayerPlugin.m" />
        <source-file src="src/ios/TsPlaybackManager.m" />
        <source-file src="src/ios/TsPlayerViewController.m" />
        <source-file src="src/ios/TsNetworkHelper.m" />

        <config-file target="config.xml" parent="/*">
            <feature name="TsNativePlayer">
                <param name="ios-package" value="TsNativePlayerPlugin" />
            </feature>
        </config-file>

        <!-- Local Network Permission (iOS 14+) -->
        <config-file target="*-Info.plist" parent="NSLocalNetworkUsageDescription">
            <string>This app needs local network access to connect to your dashcam for video playback and file management.</string>
        </config-file>

        <!-- Bonjour services — required for Local Network permission -->
        <config-file target="*-Info.plist" parent="NSBonjourServices">
            <array>
                <string>_http._tcp</string>
            </array>
        </config-file>

        <!-- Allow HTTP (not just HTTPS) for dashcam at 192.168.0.1 -->
        <config-file target="*-Info.plist" parent="NSAppTransportSecurity">
            <dict>
                <key>NSAllowsArbitraryLoads</key>
                <true/>
            </dict>
        </config-file>

    </platform>

    <platform name="android">
        <config-file target="config.xml" parent="/*">
            <feature name="TsNativePlayer">
                <param name="android-package" value="com.quikvizn.tsplayer.TsNativePlayerPlugin" />
            </feature>
        </config-file>

        <!-- Streaming the remote .TS over local WiFi needs INTERNET (cleartext is
             already enabled app-side via usesCleartextTraffic). -->
        <config-file target="AndroidManifest.xml" parent="/manifest">
            <uses-permission android:name="android.permission.INTERNET" />
        </config-file>

        <!-- Fullscreen libVLC player activity. -->
        <config-file target="AndroidManifest.xml" parent="/manifest/application">
            <activity android:name="com.quikvizn.tsplayer.TsPlayerActivity"
                      android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize"
                      android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen"
                      android:screenOrientation="fullSensor"
                      android:exported="false" />
        </config-file>

        <source-file src="src/android/TsNativePlayerPlugin.java" target-dir="src/com/quikvizn/tsplayer" />
        <source-file src="src/android/TsPlayerActivity.java" target-dir="src/com/quikvizn/tsplayer" />
        <source-file src="src/android/TsPlayerView.java" target-dir="src/com/quikvizn/tsplayer" />

        <!-- libVLC dependency (org.videolan.android:libvlc-all). -->
        <framework src="src/android/ts-player.gradle" custom="true" type="gradleReference" />
    </platform>
</plugin>